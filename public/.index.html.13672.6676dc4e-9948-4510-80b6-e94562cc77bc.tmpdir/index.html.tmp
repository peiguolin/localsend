<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>局域网聊天室</title>
  <script>
    // 主题初始化（须在样式表之前执行，避免首屏闪烁）
    (function () {
      var t = null;
      try { t = localStorage.getItem('localsend-theme'); } catch (e) { /* ignore */ }
      if (t !== 'dark' && t !== 'light') {
        t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
      }
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="app">
    <!-- 顶部栏 -->
    <header class="topbar">
      <div class="topbar-left">
        <h1 class="title">局域网聊天室</h1>
        <nav class="tabs">
          <button class="tab active" id="tabChat" type="button">聊天</button>
          <button class="tab" id="tabShare" type="button">共享文件</button>
          <button class="tab" id="tabBoard" type="button">白板</button>
          <button class="tab" id="tabScreen" type="button">屏幕共享</button>
          <button class="tab" id="tabCalendar" type="button">日历</button>
          <button class="tab" id="tabData" type="button">数据</button>
        </nav>
        <span class="badge" id="connStatus">连接中…</span>
      </div>
      <div class="topbar-right">
        <button class="sidebar-toggle" id="sidebarToggle" type="button" title="成员与房间" hidden>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
        <button class="theme-toggle" id="themeToggle" type="button" title="切换深色 / 浅色模式">
          <svg class="theme-icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
          <svg class="theme-icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
          </svg>
        </button>
        <span class="members-label">在线 <span id="onlineCount">0</span> 人</span>
        <span class="my-name editable" id="myName" title="点击修改昵称">—</span>
        <input class="my-name-input" id="myNameInput" maxlength="20" hidden>
        <span class="nick-error" id="nickError" hidden></span>
      </div>
    </header>

    <!-- 主区域：消息区 + 成员列表 -->
    <main class="main" id="chatMain">
      <div class="chat-wrap">
        <div class="today-banner" id="todayBanner" hidden></div>
        <div class="room-titlebar">
          <span class="rt-name">公共房</span>
          <span class="rt-hint" id="roomTitleHint">所有人都在这里聊天</span>
          <button class="rt-clear" id="roomClearBtn" type="button" hidden>清空记录</button>
        </div>
        <div class="chat-area" id="chatArea">
          <!-- 消息将动态渲染到这里 -->
        </div>
        <button class="unread-pill" id="unreadPill" type="button">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
          <span id="unreadPillText"></span>
        </button>
      </div>
      <aside class="sidebar">
        <div class="sidebar-head">
          <div class="sidebar-title">在线成员</div>
          <button class="group-call-btn" id="groupCallBtn" type="button" title="呼叫所有在线成员">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            群呼
          </button>
        </div>
        <div class="member-select-hint" id="memberSelectHint">点击成员名字可多选，然后发起通话</div>
        <ul class="member-list" id="memberList"></ul>
        <div class="call-action-bar" id="callActionBar" hidden>
          <button class="call-action-btn" id="callSelectedBtn" type="button">发起通话 (0)</button>
          <button class="call-action-clear" id="callSelectionClearBtn" type="button" title="取消选择">✕</button>
        </div>

        <!-- 我的房间：公共房 + 我加入的群聊房 -->
        <div class="room-section">
          <div class="room-section-head">
            <span class="sidebar-title">我的房间</span>
            <button class="room-create-btn" id="roomCreateBtn" type="button" title="从在线成员多选，拉起新的群聊房间">＋ 拉起群聊</button>
          </div>
          <ul class="room-list" id="roomList">
            <li class="room-item active" data-room="main" id="roomMain">
              <span class="room-name">💬 公共房</span>
              <span class="room-members">所有人</span>
              <span class="room-unread" id="roomUnreadMain" hidden>0</span>
            </li>
          </ul>
        </div>
      </aside>
    </main>

    <!-- 文件夹共享面板 -->
    <main class="main share-main" id="shareView" hidden>
      <!-- 共享列表视图 -->
      <div class="share-panel" id="shareHome">
        <div class="share-panel-head">
          <div class="sidebar-title">大家的共享</div>
          <button class="share-primary-btn" id="createShareBtn" type="button">+ 共享我的文件夹</button>
        </div>
        <div class="my-share-box" id="myShareBox" hidden></div>
        <ul class="share-list" id="shareList"></ul>
        <div class="share-empty" id="shareEmpty" hidden>
          还没有人共享文件夹<br>
          <small>点击「+ 共享我的文件夹」成为第一个（需 Chrome / Edge）</small>
        </div>
        <div class="upload-hint" id="shareHomeHint"></div>
      </div>

      <!-- 文件浏览视图 -->
      <div class="share-panel" id="shareBrowser" hidden>
        <div class="browser-toolbar">
          <button class="tool-btn" id="browserBackBtn" type="button">← 共享列表</button>
          <nav class="breadcrumb" id="breadcrumb"></nav>
          <div class="browser-actions">
            <button class="tool-btn icon-btn" id="browserRefreshBtn" type="button" title="刷新">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
              </svg>
            </button>
            <button class="share-primary-btn" id="shareUploadBtn" type="button" hidden>上传到此目录</button>
          </div>
        </div>
        <div class="browser-meta" id="browserMeta"></div>
        <div class="browser-table-wrap">
          <table class="browser-table">
            <thead>
              <tr><th class="col-name">名称</th><th class="col-size">大小</th><th class="col-mtime">修改时间</th><th class="col-op">操作</th></tr>
            </thead>
            <tbody id="browserRows"></tbody>
          </table>
          <div class="share-empty" id="browserEmpty" hidden>空目录</div>
          <div class="share-empty" id="browserLoading">加载中…</div>
        </div>
        <div class="upload-hint" id="shareBrowserHint"></div>
      </div>
      <input type="file" id="shareUploadInput" hidden>
    </main>

    <!-- 实时白板面板 -->
    <main class="main board-main" id="boardView" hidden>
      <div class="share-panel board-panel">
        <div class="board-toolbar">
          <div class="board-colors" id="boardColors"></div>
          <input type="color" class="board-color-input" id="boardColorPicker" value="#1f2328" title="自定义颜色">
          <span class="board-sep"></span>
          <label class="board-size-label" title="笔画粗细">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" fill="currentColor" stroke="none"/></svg>
            <input type="range" id="boardSize" min="1" max="30" value="4">
          </label>
          <span class="board-sep"></span>
          <button class="tool-btn" id="boardEraser" type="button" title="橡皮擦">橡皮</button>
          <button class="tool-btn" id="boardUndo" type="button" title="撤销我的最后一笔">撤销</button>
          <button class="tool-btn danger" id="boardClear" type="button" title="清空整块白板（所有人同步）">清空</button>
          <span class="board-hint">实时协作白板 · 所有人共用一块画布</span>
        </div>
        <div class="board-canvas-wrap" id="boardWrap">
          <canvas id="boardCanvas"></canvas>
        </div>
      </div>
    </main>

    <!-- 屏幕共享面板 -->
    <main class="main screen-main" id="screenView" hidden>
      <div class="share-panel screen-panel">
        <div class="screen-toolbar">
          <div class="screen-status" id="ssStatus">当前没有人共享屏幕</div>
          <div class="screen-actions">
            <button class="share-primary-btn" id="ssStartBtn" type="button">共享我的屏幕</button>
            <button class="tool-btn danger" id="ssStopBtn" type="button" hidden>停止共享</button>
            <button class="share-primary-btn" id="ssWatchBtn" type="button" hidden>观看共享</button>
            <button class="tool-btn" id="ssUnwatchBtn" type="button" hidden>退出观看</button>
          </div>
        </div>
        <div class="screen-stage" id="ssStage">
          <video id="ssVideo" autoplay playsinline hidden></video>
          <div class="screen-empty" id="ssEmpty">
            还没有人共享屏幕<br>
            <small>点「共享我的屏幕」，把你的整个屏幕 / 某个窗口 / 浏览器标签页实时播给大家</small>
          </div>
        </div>
        <div class="screen-viewers" id="ssViewersBox" hidden>
          <span class="sidebar-title">观看者（<span id="ssViewerCount">0</span>）</span>
          <div class="screen-viewer-chips" id="ssViewerChips"></div>
        </div>
        <div class="upload-hint" id="ssHint"></div>
      </div>
    </main>

    <!-- 数据面板（历史 / 搜索 / 统计） -->
    <main class="main data-main" id="dataView" hidden>
      <div class="share-panel data-panel">
        <div class="data-header">
          <span class="sidebar-title">数据面板</span>
          <span class="data-db-path" id="dataDbPath"></span>
        </div>

        <div class="data-stats" id="dataStats">
          <div class="stat-card"><div class="stat-num" id="statMessages">-</div><div class="stat-label">消息总数</div></div>
          <div class="stat-card"><div class="stat-num" id="statFiles">-</div><div class="stat-label">文件/图片</div></div>
          <div class="stat-card"><div class="stat-num" id="statStrokes">-</div><div class="stat-label">白板笔迹</div></div>
          <div class="stat-card"><div class="stat-num" id="statDbSize">-</div><div class="stat-label">库文件大小</div></div>
          <div class="stat-card"><div class="stat-num" id="statDiskFiles">-</div><div class="stat-label">磁盘文件数</div></div>
          <div class="stat-card"><div class="stat-num" id="statDiskBytes">-</div><div class="stat-label">磁盘占用</div></div>
        </div>
        <div class="data-range" id="dataRange">最早记录：— · 最新记录：—</div>
        <div class="data-range" id="dataRetention">保留策略：—</div>

        <div class="data-search">
          <input class="data-search-input" id="dataSearchKeyword" type="text" placeholder="搜索关键词（消息内容 / 文件名）…">
          <input class="data-search-input data-search-narrow" id="dataSearchNick" type="text" placeholder="按昵称筛选…">
          <button class="tool-btn" id="dataSearchBtn" type="button">搜索</button>
          <button class="tool-btn" id="dataSearchReset" type="button" hidden>重置</button>
        </div>
        <div class="data-search-meta" id="dataSearchMeta"></div>
        <div class="data-results" id="dataResults">
          <div class="data-empty">搜索历史消息，或查看下方统计。数据保存在宿主机 data/chat.db（SQLite）。</div>
        </div>

        <div class="data-actions">
          <button class="share-primary-btn" id="dataExportBtn" type="button">导出备份（下载 chat.db）</button>
          <button class="tool-btn" id="dataSweepBtn" type="button">立即清理</button>
          <button class="tool-btn danger" id="dataClearBtn" type="button">清空历史</button>
        </div>
        <div class="upload-hint" id="dataHint"></div>
      </div>
    </main>

    <!-- 日历面板 -->
    <main class="main calendar-main" id="calendarView" hidden>
      <div class="share-panel calendar-panel">
        <div class="cal-toolbar">
          <select class="cal-room-select" id="calRoomSelect" title="日程所属房间"></select>
          <div class="cal-nav">
            <button class="tool-btn icon-btn" id="calPrevYear" type="button" title="上一年">«</button>
            <button class="tool-btn icon-btn" id="calPrevMonth" type="button" title="上一月">‹</button>
            <span class="cal-title" id="calTitle">—</span>
            <button class="tool-btn icon-btn" id="calNextMonth" type="button" title="下一月">›</button>
            <button class="tool-btn icon-btn" id="calNextYear" type="button" title="下一年">»</button>
          </div>
          <div class="cal-actions">
            <button class="tool-btn" id="calTodayBtn" type="button">今天</button>
            <button class="tool-btn" id="calModeBtn" type="button" title="切换月/年视图">年视图</button>
          </div>
        </div>
        <div class="cal-official-tip" id="calOfficialTip" hidden></div>
        <div class="cal-month-grid" id="calGrid"></div>
        <div class="cal-year-grid" id="calYearGrid" hidden></div>
        <div class="cal-legend">
          <span><i class="cal-badge-mini rest">休</i> 节假日</span>
          <span><i class="cal-badge-mini work">班</i> 调休上班</span>
          <span><i class="cal-dot-mini"></i> 有日程</span>
          <span class="cal-legend-dim">日期下方小字为农历 / 节气 / 传统节日</span>
        </div>
      </div>
    </main>

    <!-- 日期详情 + 日程弹窗 -->
    <div class="modal" id="calDayModal" hidden>
      <div class="modal-backdrop"></div>
      <div class="modal-card cal-day-card">
        <div class="cal-day-head">
          <div>
            <div class="cal-day-title" id="calDayTitle">—</div>
            <div class="cal-day-sub" id="calDaySub">—</div>
          </div>
          <button class="quote-preview-x" id="calDayClose" type="button" title="关闭">×</button>
        </div>
        <div class="cal-day-holiday" id="calDayHoliday" hidden></div>
        <div class="sidebar-title">当日日程</div>
        <div class="cal-event-list" id="calEventList"></div>
        <div class="sidebar-title">添加日程</div>
        <div class="cal-add-form">
          <input class="modal-input" id="calEvTitle" placeholder="标题（如：版本评审 / 值班：小明）" maxlength="60">
          <div class="cal-add-row">
            <input class="modal-input cal-time-input" id="calEvTime" type="time" title="时间（提醒需要）">
            <select class="modal-input cal-remind-select" id="calEvRemind" title="到点向房间发送提醒（需填写时间）">
              <option value="0">不提醒</option>
              <option value="10">提前 10 分钟</option>
              <option value="30">提前 30 分钟</option>
              <option value="60">提前 1 小时</option>
              <option value="1440">提前 1 天</option>
            </select>
          </div>
          <div class="cal-add-row">
            <input class="modal-input" id="calEvNote" placeholder="备注（可选）" maxlength="200">
          </div>
          <button class="share-primary-btn" id="calEvAddBtn" type="button">添加</button>
        </div>
        <div class="modal-tip error" id="calEvError" hidden></div>
      </div>
    </div>

    <!-- 移动端：房间标签栏（横滑切换，贴底部输入栏上方） -->
    <nav class="mobile-roombar" id="mobileRoomBar" hidden>
      <ul class="mobile-room-list" id="mobileRoomList"></ul>
    </nav>

    <!-- 底部输入区 -->
    <footer class="inputbar">
      <div class="quote-preview" id="quotePreview" hidden></div>
      <div class="input-row">
        <label class="file-btn" title="选择文件发送">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
          </svg>
          <span>文件</span>
        </label>
        <input type="file" id="fileInput" hidden>
        <button type="button" id="emojiBtn" class="emoji-btn" title="插入表情">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
            <line x1="9" y1="9" x2="9.01" y2="9"/>
            <line x1="15" y1="9" x2="15.01" y2="9"/>
          </svg>
        </button>
        <input type="text" id="msgInput" class="msg-input" placeholder="输入消息，Enter 发送" autocomplete="off">
        <button id="sendBtn" class="send-btn">发送</button>
      </div>
      <div class="upload-hint" id="uploadHint"></div>
      <!-- 表情选择器面板 -->
      <div class="emoji-panel" id="emojiPanel" hidden>
        <div class="emoji-search-row">
          <input type="text" id="emojiSearch" class="emoji-search" placeholder="搜索表情…" autocomplete="off">
        </div>
        <div class="emoji-tabs" id="emojiTabs" role="tablist"></div>
        <div class="emoji-grid" id="emojiGrid"></div>
      </div>
    </footer>
  </div>

  <!-- 创建共享弹窗 -->
  <div class="modal" id="createShareModal" hidden>
    <div class="modal-backdrop"></div>
    <div class="modal-card">
      <div class="modal-title">共享我的文件夹</div>
      <label class="modal-label">共享名称
        <input class="modal-input" id="csName" placeholder="留空则使用文件夹名" maxlength="50">
      </label>
      <label class="modal-label">访问密码（可选）
        <input class="modal-input" id="csPassword" type="password" placeholder="不填则任何人可访问" maxlength="64">
      </label>
      <label class="modal-check">
        <input type="checkbox" id="csWritable"> 允许他人上传文件到我的文件夹
      </label>
      <div class="modal-tip" id="csTip">确认后会弹出系统文件夹选择器，选择要共享的文件夹（需 Chrome / Edge，共享期间本页面需保持打开）</div>
      <div class="modal-btns">
        <button class="tool-btn" id="csCancel" type="button">取消</button>
        <button class="share-primary-btn" id="csConfirm" type="button">选择文件夹并开始共享</button>
      </div>
    </div>
  </div>

  <!-- 共享密码弹窗 -->
  <div class="modal" id="pwdModal" hidden>
    <div class="modal-backdrop"></div>
    <div class="modal-card">
      <div class="modal-title" id="pwdTitle">输入访问密码</div>
      <label class="modal-label">密码
        <input class="modal-input" id="pwdInput" type="password" placeholder="请输入共享密码" maxlength="64">
      </label>
      <div class="modal-tip error" id="pwdError" hidden></div>
      <div class="modal-btns">
        <button class="tool-btn" id="pwdCancel" type="button">取消</button>
        <button class="share-primary-btn" id="pwdConfirm" type="button">进入共享</button>
      </div>
    </div>
  </div>

  <!-- 管理共享弹窗 -->
  <div class="modal" id="manageShareModal" hidden>
    <div class="modal-backdrop"></div>
    <div class="modal-card">
      <div class="modal-title">管理我的共享</div>
      <label class="modal-label">共享名称
        <input class="modal-input" id="msName" maxlength="50">
      </label>
      <label class="modal-label">新密码（留空则不修改）
        <input class="modal-input" id="msPassword" type="password" placeholder="留空不修改密码" maxlength="64">
      </label>
      <label class="modal-check">
        <input type="checkbox" id="msClearPassword"> 取消密码（任何人可访问）
      </label>
      <label class="modal-check">
        <input type="checkbox" id="msWritable"> 允许他人上传文件到我的文件夹
      </label>
      <div class="modal-tip" id="msTip">修改密码后，已访问的其他成员需要重新输入密码</div>
      <div class="modal-btns">
        <button class="tool-btn" id="msCancel" type="button">取消</button>
        <button class="share-primary-btn" id="msConfirm" type="button">保存</button>
      </div>
    </div>
  </div>

  <!-- WebRTC 语音通话弹窗 -->
  <div class="modal call-modal" id="callModal" hidden>
    <div class="modal-backdrop"></div>
    <div class="modal-card call-card">
      <div class="call-avatar">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
      </div>
      <div class="call-title" id="callTitle">语音通话</div>
      <div class="call-status" id="callStatus">…</div>
      <div class="call-members" id="callMembers"></div>
      <div class="call-timer" id="callTimer" hidden>00:00</div>
      <div class="call-audios" id="callAudios"></div>
      <div class="call-btns">
        <button class="call-btn call-accept" id="callAcceptBtn" type="button" hidden>接听</button>
        <button class="call-btn call-reject" id="callRejectBtn" type="button" hidden>拒绝</button>
        <button class="call-btn call-mute" id="callMuteBtn" type="button" hidden>静音</button>
        <button class="call-btn call-end" id="callEndBtn" type="button">挂断</button>
      </div>
    </div>
  </div>

  <!-- 拉起群聊弹窗 -->
  <div class="modal" id="groupModal" hidden>
    <div class="modal-backdrop"></div>
    <div class="modal-card">
      <div class="modal-title">拉起群聊</div>
      <label class="modal-label">群聊名称（可选，默认自动命名）
        <input class="modal-input" id="groupNameInput" maxlength="30" placeholder="例如：项目讨论组">
      </label>
      <div class="group-section-title">已选成员（<span id="groupSelCount">0</span>）</div>
      <div class="group-sel-list" id="groupSelList"></div>
      <div class="group-section-title">在线成员（点击添加）</div>
      <div class="group-pick-list" id="groupPickList"></div>
      <div class="modal-tip" id="groupTip">从在线成员列表里点击添加，再点「创建群聊」</div>
      <div class="modal-btns">
        <button class="tool-btn" id="groupCancel" type="button">取消</button>
        <button class="share-primary-btn" id="groupConfirm" type="button">创建群聊</button>
      </div>
    </div>
  </div>

  <!-- 移动端：抽屉遮罩（fixed，置于 body 末尾） -->
  <div class="drawer-backdrop" id="drawerBackdrop" hidden></div>

  <script src="/socket.io/socket.io.js"></script>
  <script src="vendor/highlight.min.js"></script>
  <script src="vendor/lunar.js"></script>
  <script src="client.js"></script>
  <script src="share.js"></script>
  <script src="whiteboard.js"></script>
  <script src="screen-share.js"></script>
  <script src="data-panel.js"></script>
  <script src="calendar.js"></script>
</body>
</html>
